

# Ignore vscode AI rules
.github/instructions/codacy.instructions.md

# Dependencies
node_modules/
studio/node_modules/

# Build outputs
studio/dist/
studio/.sanity/

# Environment / secrets
.env
.env.local
*.env

# Migration script (contains no secrets but not needed in git)
migrate-to-sanity.js
scripts/migrate-to-sanity.js

# One-off scripts that may contain tokens
patch-*.mjs
patch-*.js

# Test outputs
playwright-report/
test-results/

# Editor / local tooling
.vscode/
*.vsix

# AI / Copilot skill definitions — local dev tooling, not project code
.agents/

# Backup / archive files
_archive/

# Original uncompressed source images — compressed versions are in assets/images/
assets/images/_originals/

# Debug screenshots committed by mistake
assets/images/_compressed/debug-*
assets/images/_compressed/statusbar-zoom.png

# Temp files left by compress-images script
assets/images/*.tmp
