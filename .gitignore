# ══════════════════════════════════════
# arttrec Portfolio — .gitignore
# Only production files belong in the repo
# ══════════════════════════════════════

# ── OS ──
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ── IDE / Editor ──
.vscode/
.idea/
.cursor/
*.sublime-project
*.sublime-workspace
*.vsix

# ── Node ──
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Sanity Studio (has its own deploy, doesn't go with the portfolio) ──
studio/node_modules/
studio/.sanity/
studio/dist/
studio/package-lock.json

# ── Environment & secrets ──
.env
.env.local
.env.production
.env*.local

# ── Testing ──
test-results/
playwright-report/
.playwright/
playwright.config.js
tests/

# ── Temp / audit / dev-only files ──
_tmp_*.mjs
_tmp_*.js
tmp-*.png
docs/BUGS.md
docs/DESIGN-AUDIT.md
*-prompt.md
_archive/

# ── Agent / AI config (dev tooling, not production) ──
.agents/
.claude/
agent/
data/skills/
skills-lock.json
CLAUDE.md

# ── Codacy ──
.codacy/

# ── Scripts (dev utilities, not served) ──
scripts/

# ── Original / uncompressed images ──
assets/images/_originals/
assets/images/README.md

# ── Compressed image output (regenerable via scripts/compress-images.js) ──
assets/images/_compressed/

# ── Design source files ──
*.psd
*.ai
*.sketch
*.fig
*.xd
*.indd
*.afdesign
*.afphoto

# ── Large media ──
*.mp4
*.mov
*.avi
*.zip
*.rar
*.7z

# ── Logs ──
*.log
